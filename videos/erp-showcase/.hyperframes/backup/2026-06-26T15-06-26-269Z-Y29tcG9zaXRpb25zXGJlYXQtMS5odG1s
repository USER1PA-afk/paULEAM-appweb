<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1920, height=1080">
    <title>PAuleam Beat 1 — Brand Hero</title>
  </head>
  <body>
    <template>
      <style>
        #root {
          position: relative;
          width: 1920px;
          height: 1080px;
          background: #FFFFFF;
          overflow: hidden;
          font-family: "Inter", system-ui, sans-serif;
          color: #121212;
        }

        .ecuador-stripe {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 12px;
          display: flex;
          z-index: 10;
          transform-origin: top center;
        }
        .ecuador-stripe > div { flex: 1; height: 100%; }
        .stripe-yellow { background: #FCD116; }
        .stripe-blue { background: #003893; }
        .stripe-red { background: #CC0000; }

        .content {
          position: absolute;
          inset: 0;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
        }

        .logo-frame {
          display: flex;
          align-items: center;
          justify-content: center;
          will-change: transform, opacity;
        }

        .logo-frame img {
          display: block;
          width: 200px;
          height: auto;
          object-fit: contain;
        }

        .wordmark {
          display: block;
          margin-top: 28px;
          font-family: "Inter", system-ui, sans-serif;
          font-weight: 800;
          font-size: 140px;
          line-height: 1;
          color: #CC0000;
          letter-spacing: -0.04em;
          will-change: transform, opacity;
        }

        .slogan {
          display: block;
          margin-top: 24px;
          font-family: "Inter", system-ui, sans-serif;
          font-weight: 500;
          font-size: 32px;
          line-height: 1.2;
          color: #121212;
          letter-spacing: -0.005em;
          text-align: center;
          will-change: transform, opacity;
        }

        .slogan-word {
          display: inline-block;
        }

        .footer {
          position: absolute;
          bottom: 36px;
          left: 0;
          right: 0;
          text-align: center;
          font-family: ui-monospace, "SF Mono", Consolas, monospace;
          font-size: 13px;
          font-weight: 500;
          color: #4A4A49;
          opacity: 0;
          letter-spacing: 0.08em;
        }
      </style>

      <div id="root" data-composition-id="beat-1" data-start="0" data-duration="5" data-width="1920" data-height="1080">
        <div class="ecuador-stripe">
          <div class="stripe-yellow"></div>
          <div class="stripe-blue"></div>
          <div class="stripe-red"></div>
        </div>

        <div class="content">
          <div class="logo-frame">
            <img src="assets/logo-pauleam.png" alt="PAuleam">
          </div>
          <h1 class="wordmark">PAuleam</h1>
          <h2 class="slogan">
            <span class="slogan-word">Gestión</span>
            <span class="slogan-word">Integral</span>
            <span class="slogan-word">de</span>
            <span class="slogan-word">tu</span>
            <span class="slogan-word">Planta</span>
            <span class="slogan-word">de</span>
            <span class="slogan-word">Alimentos</span>
          </h2>
        </div>

        <div class="footer">ULEAM · Planta de Alimentos · 2026</div>
      </div>

      <script>
        window.__timelines = window.__timelines || {};
        const tl = gsap.timeline({ paused: true });

        // ANIMATION ORDER: stripe -> logo -> PAuleam title -> slogan -> footer
        tl.fromTo(".ecuador-stripe", { scaleY: 0 }, { scaleY: 1, duration: 0.4, ease: "power2.out", transformOrigin: "top center" }, 0);

        // 1) logo
        tl.fromTo(".logo-frame", { scale: 0.85, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.6, ease: "back.out(1.4)" }, 0.2);

        // 2) PAuleam title
        tl.fromTo(".wordmark", { y: 16, opacity: 0 }, { y: 0, opacity: 1, duration: 0.6, ease: "power2.out" }, 0.6);

        // 3) slogan ("Gestión Integral de tu Planta de Alimentos") — word by word
        tl.fromTo(".slogan-word", { y: 12, opacity: 0 }, {
          y: 0,
          opacity: 1,
          duration: 0.4,
          stagger: 0.08,
          ease: "power2.out"
        }, 1.4);

        // 4) footer — appears at 2.0s, length 0.3s (simple opacity fade)
        tl.fromTo(
          ".footer",
          { opacity: 0 },
          { opacity: 0.6, duration: 0.3, ease: "power2.out" },
          2.0
        );

        tl.to(".footer", {
          keyframes: { "0%": {
            rotation: 13,
            opacity: 0.6
          }, "100%": { rotation: 0, opacity: 0.6 } },
          duration: 1
        }, 0);

        window.__timelines["beat-1"] = tl;
      </script>
    </template>
  </body>
</html>
